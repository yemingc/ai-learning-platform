DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
AUTH_SECRET=change_me_to_a_long_random_secret
AUTH_TRUST_HOST=true

# Default workflow engine is LangGraph.
# Set to "typescript" to use the deterministic TypeScript fallback runner.
TEACHER_WORKFLOW_ENGINE=langgraph

# Per-learner AI Teacher quotas. Limits are enforced server-side before a model call.
AI_TEACHER_BURST_LIMIT=12
AI_TEACHER_BURST_WINDOW_SECONDS=600
AI_TEACHER_DAILY_LIMIT=100

# AI run metadata is retained locally for this many days.
AI_RUN_RETENTION_DAYS=90

# AI Teacher curriculum retrieval mode. Use "keyword" as the safest baseline,
# or "embedding" after building the local embedding index.
RAG_RETRIEVAL_MODE=keyword

# Local development includes workflow trace data automatically.
# Set this to true for a production portfolio demo if you want the
# Workflow Inspector to collect LangGraph trace data after deployment.
# Restart the dev server after changing this value.
NEXT_PUBLIC_SHOW_AI_TRACE=false

# Developer tools are separate from student login.
# Local development enables tools by default; production should explicitly opt in.
ENABLE_DEVELOPER_TOOLS=true
DEVELOPER_MODE_PASSWORD=

# Embedding retrieval is optional. It is used only for developer retrieval
# preview/indexing until retrieval quality is evaluated.
EMBEDDING_PROVIDER=openai-compatible
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=

# Optional. Required for production/shared indexing endpoints.
EMBEDDING_INDEX_SECRET=
EMBEDDING_INDEX_BASE_URL=http://localhost:3000
EMBEDDING_INDEX_LOCALE=all
EMBEDDING_INDEX_FORCE=false
