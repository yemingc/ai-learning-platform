DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
AUTH_SECRET=change_me_to_a_long_random_secret
AUTH_TRUST_HOST=true

# Default workflow engine is LangGraph.
# Set to "typescript" to use the deterministic TypeScript fallback runner.
TEACHER_WORKFLOW_ENGINE=langgraph

# Per-learner AI Teacher quotas. Limits are enforced server-side before a model call.
AI_TEACHER_BURST_LIMIT=12
AI_TEACHER_BURST_WINDOW_SECONDS=600
AI_TEACHER_DAILY_LIMIT=100

# AI run metadata is retained locally for this many days.
AI_RUN_RETENTION_DAYS=90

# AI Teacher curriculum retrieval mode. Hybrid is the evaluated default and
# degrades explicitly to keyword retrieval if the embedding path is unavailable.
RAG_RETRIEVAL_MODE=hybrid

# Calibrated relevance gates. Results below the active mode's score are rejected
# instead of being sent to the model. Re-run the 48-case evaluation before tuning.
RAG_KEYWORD_MIN_SCORE=4
RAG_EMBEDDING_MIN_SCORE=48
RAG_HYBRID_MIN_SCORE=20
RAG_HYBRID_KEYWORD_WEIGHT=65
RAG_HYBRID_EMBEDDING_WEIGHT=35

# Local development includes workflow trace data automatically.
# Set this to true for a production portfolio demo if you want the
# Workflow Inspector to collect LangGraph trace data after deployment.
# Restart the dev server after changing this value.
NEXT_PUBLIC_SHOW_AI_TRACE=false

# Developer tools are separate from student login.
# Local development enables tools by default; production should explicitly opt in.
ENABLE_DEVELOPER_TOOLS=true
DEVELOPER_MODE_PASSWORD=

# Optional shared portfolio learner. Disabled by default. When enabled, the
# login page intentionally exposes these credentials for one-click demo access.
# Only reserved example.com identities are accepted, and the password must not
# reuse any privileged application/developer/report/index secret.
ENABLE_PUBLIC_DEMO_ACCOUNT=false
DEMO_ACCOUNT_EMAIL=demo.learner@example.com
DEMO_ACCOUNT_PASSWORD=change_me_to_a_unique_demo_password
DEMO_ACCOUNT_NAME=Portfolio Demo Learner
DEMO_BASE_URL=http://localhost:3000

# Dedicated bearer secret for CI evaluation report export. Do not reuse the
# embedding index secret. Browser downloads use authenticated Developer Mode.
AI_EVALUATION_REPORT_SECRET=
AI_EVALUATION_REPORT_BASE_URL=http://localhost:3000

# Embedding retrieval powers the default hybrid path. Keyword remains the
# deterministic fallback when the embedding index is unavailable or stale.
EMBEDDING_PROVIDER=openai-compatible
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=

# Optional. Required for production/shared indexing endpoints.
EMBEDDING_INDEX_SECRET=
EMBEDDING_INDEX_BASE_URL=http://localhost:3000
EMBEDDING_INDEX_LOCALE=all
EMBEDDING_INDEX_FORCE=false
